{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/preview.html",
      "headers": [
        { "key": "Content-Security-Policy", "value": "sandbox allow-scripts allow-forms allow-modals allow-popups" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/(app.js|styles.css|config.js|index.html)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
